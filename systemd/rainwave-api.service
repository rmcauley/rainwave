[Unit]
Description=Rainwave Internet Radio Web API
Wants=network.target
Requires=postgresql.service memcached.service memcached_ratings.service rainwave-zmq-proxy.service
After=rainwave-zmq-proxy.service

[Service]
Type=simple
User=rainwave
Group=www-data
WorkingDirectory=/home/rainwave/rainwave
ExecStart=/home/rainwave/.local/bin/uv run python src/rw_api.py
LimitNOFILE=32767

[Install]
WantedBy=multi-user.target
